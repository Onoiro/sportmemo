# Скопируйте в .env и заполните. В dev достаточно значений по умолчанию.

# --- Django ---
DEBUG=True
SECRET_KEY=dev-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=ru

# Имена cookie. В dev они с префиксом проекта: cookie не различаются по порту,
# и соседний проект на другом порту localhost стирает нашу сессию. На сервере
# значения по умолчанию (`sessionid`, `csrftoken`) — сайт там один.
# SESSION_COOKIE_NAME=sportmemo_sessionid
# CSRF_COOKIE_NAME=sportmemo_csrftoken

# --- База данных ---
# Формат: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://sportmemo:sportmemo@localhost:5432/sportmemo

# --- Redis (брокер Celery) ---
REDIS_URL=redis://localhost:6379/0
# В dev задачи выполняются сразу, без воркера. На сервере — False.
# Значение по умолчанию следует DEBUG.
# CELERY_TASK_ALWAYS_EAGER=True

# --- MinIO / S3 (хранилище файлов) ---
# В dev можно оставить USE_S3=False — файлы будут писаться в media/
USE_S3=False
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sportmemo
MINIO_USE_SSL=False

# --- Почта (Yandex Cloud Postbox) ---
# Приём писем — VK WorkSpace (MX на emx.mail.ru), отправка — Postbox.
# Postbox не принимает входящие: MX-записей у него нет вовсе.
# В dev используется console backend, если EMAIL_HOST пуст.
# В dev по умолчанию письма печатаются в консоль `runserver`: это удобно
# и безопасно, но живой отправки не проверяет. Для проверки SMTP включите
# бэкенд явно — иначе `mail_check` покажет console, а письмо никуда не уйдёт.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=postbox.cloud.yandex.net
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=10
# EMAIL_HOST_USER — идентификатор API-ключа сервисного аккаунта
# postbox-user, а НЕ адрес ящика. Роль postbox.sender, область
# действия ключа yc.postbox.send. Адрес ящика здесь даёт
# 535 Authentication failed.
EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD — секретная часть API-ключа, а НЕ пароль
# от ящика. Хранится только в .env, в git не попадает.
EMAIL_HOST_PASSWORD=
# Отправитель с именем: ящика noreply@ не существует, ответы
# на письма приходят в info@sportmemo.ru (VK WorkSpace).
DEFAULT_FROM_EMAIL=SportMemo <info@sportmemo.ru>
# Контакт для обращений. В 5.5 станет LEGAL_CONTACT_EMAIL.
CONTACT_EMAIL=info@sportmemo.ru

# --- Docker Compose (для сервиса db) ---
POSTGRES_DB=sportmemo
POSTGRES_USER=sportmemo
POSTGRES_PASSWORD=sportmemo
