# Скопируйте в .env и заполните. В dev достаточно значений по умолчанию.

# --- Django ---
DEBUG=True
SECRET_KEY=dev-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=ru

# Имена cookie. В dev они с префиксом проекта: cookie не различаются по порту,
# и соседний проект на другом порту localhost стирает нашу сессию. На сервере
# значения по умолчанию (`sessionid`, `csrftoken`) — сайт там один.
# SESSION_COOKIE_NAME=sportmemo_sessionid
# CSRF_COOKIE_NAME=sportmemo_csrftoken

# --- Режимы стейджа ---
# Регистрация: на стейдже False (сервер за границей, реальные ПДн нельзя).
SIGNUP_OPEN=True
# Закрыть всё от индексации: X-Robots-Tag и Disallow: / в robots.txt.
NOINDEX_ALL=False

# --- База данных ---
# Формат: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://sportmemo:sportmemo@localhost:5432/sportmemo

# --- Redis (брокер Celery) ---
REDIS_URL=redis://localhost:6379/0
# В dev задачи выполняются сразу, без воркера. На сервере — False.
# Значение по умолчанию следует DEBUG.
# CELERY_TASK_ALWAYS_EAGER=True

# --- S3 (хранилище файлов) ---
# В dev можно оставить USE_S3=False — файлы будут писаться в media/
USE_S3=False
# Имена `S3_*` — наши: в бою провайдер Yandex Object Storage, а не MinIO.
# Внутри django-storages настройки называются `AWS_*`, их не переименовать.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Публичный бакет: чтение без подписи, превью и логотипы.
S3_BUCKET=sportmemo
# Приватный бакет: оригиналы, ссылка подписывается на час.
S3_PRIVATE_BUCKET=sportmemo-private
S3_USE_SSL=False

# --- Кеш ---
# База /1, а не /0: нулевая занята брокером Celery.
CACHE_URL=redis://localhost:6379/1

# --- Почта (Yandex Cloud Postbox) ---
# Приём писем — VK WorkSpace (MX на emx.mail.ru), отправка — Postbox.
# Postbox не принимает входящие: MX-записей у него нет вовсе.
# В dev используется console backend, если EMAIL_HOST пуст.
# В dev по умолчанию письма печатаются в консоль `runserver`: это удобно
# и безопасно, но живой отправки не проверяет. Для проверки SMTP включите
# бэкенд явно — иначе `mail_check` покажет console, а письмо никуда не уйдёт.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=postbox.cloud.yandex.net
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=10
# EMAIL_HOST_USER — идентификатор API-ключа сервисного аккаунта
# postbox-user, а НЕ адрес ящика. Роль postbox.sender, область
# действия ключа yc.postbox.send. Адрес ящика здесь даёт
# 535 Authentication failed.
EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD — секретная часть API-ключа, а НЕ пароль
# от ящика. Хранится только в .env, в git не попадает.
EMAIL_HOST_PASSWORD=
# Отправитель с именем: ящика noreply@ не существует, ответы
# на письма приходят в info@sportmemo.ru (VK WorkSpace).
DEFAULT_FROM_EMAIL=SportMemo <info@sportmemo.ru>
# Контакт для обращений. В 5.5 станет LEGAL_CONTACT_EMAIL.
CONTACT_EMAIL=info@sportmemo.ru

# --- Docker Compose (для сервиса db) ---
POSTGRES_DB=sportmemo
POSTGRES_USER=sportmemo
POSTGRES_PASSWORD=sportmemo

# --- Бэкапы (scripts/backup.sh) ---
# Бот и чат только для алертов SportMemo. Чужой токен не переиспользуем:
# сбой соседнего проекта не должен выглядеть как наш.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Только для прода: с прод-сервера api.telegram.org заблокирован ТСПУ,
# и алерт идёт через tinyproxy на стейдже. На стейдже прокси не задаётся:
# api.telegram.org доступен напрямую, а tinyproxy пускает только прод-IP
# и на запрос со стейджа отвечает 403.
# TELEGRAM_PROXY=http://89.125.130.69:8888
# Какой compose-файл считать источником БД: stage или prod.
# BACKUP_COMPOSE_FILE=docker-compose.stage.yml
# Имя remote из ~/.config/rclone/rclone.conf (параметры Cloud.ru — в README).
# BACKUP_RCLONE_REMOTE=cloudru
# BACKUP_BUCKET=sportmemo-backup
# Сколько дампов держать локально (в бакете срок задаёт
# BACKUP_RETENTION_DAYS).
# BACKUP_KEEP_LOCAL=7
# BACKUP_RETENTION_DAYS=30
# Меньше этого объёма свободного места дамп не начинается: иначе дамп
# забьёт диск, на котором лежат медиа.
# BACKUP_MIN_FREE_MB=1024
# Разрешить restore-check создавать временную БД. Только на стейдже.
# BACKUP_ALLOW_RESTORE_CHECK=0
# Путь к rclone, если его нет в PATH (установка без sudo — в README).
# RCLONE_BIN=/home/abo/.local/bin/rclone
