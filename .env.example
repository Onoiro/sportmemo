# Скопируйте в .env и заполните. В dev достаточно значений по умолчанию.

# --- Django ---
DEBUG=True
SECRET_KEY=dev-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=ru

# --- База данных ---
# Формат: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://sportmemo:sportmemo@localhost:5432/sportmemo

# --- Redis (брокер Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 (хранилище файлов) ---
# В dev можно оставить USE_S3=False — файлы будут писаться в media/
USE_S3=False
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sportmemo
MINIO_USE_SSL=False

# --- Почта ---
# В dev используется console backend; SMTP (Yandex Cloud Postbox) настраивается на этапе 4
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=noreply@sportmemo.ru

# --- Docker Compose (для сервиса db) ---
POSTGRES_DB=sportmemo
POSTGRES_USER=sportmemo
POSTGRES_PASSWORD=sportmemo
